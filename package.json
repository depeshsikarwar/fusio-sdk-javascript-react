{
  "name": "fusio-sdk-javascript-react",
  "version": "0.1.0",
  "description": "Fusio React SDK with reusable authentication components, context provider, and custom endpoint hooks",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/depeshsikarwar/fusio-sdk-javascript-react.git"
  },
  "keywords": [
    "fusio",
    "fusio-sdk",
    "react",
    "typescript",
    "auth",
    "login",
    "registration",
    "password-reset",
    "rest-api"
  ],
  "author": "Depesh Sikarwar <sikarwardepesh07@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/depeshsikarwar/fusio-sdk-javascript-react/issues"
  },
  "homepage": "https://github.com/depeshsikarwar/fusio-sdk-javascript-react#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "fusio-sdk": "^7.0.14",
    "sdkgen-client": "^2.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
